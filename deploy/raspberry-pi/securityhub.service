# /etc/systemd/system/securityhub.service - Security Hub assessment (started by securityhub.timer, 4 times a day)
[Unit]
Description=Security Hub - security posture assessment
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=securityhub
Group=securityhub
EnvironmentFile=/etc/securityhub/env
Environment=NO_COLOR=1
UMask=0027
WorkingDirectory=/opt/securityhub/config
ExecStart=/opt/securityhub/venv/bin/securityhub run -q -c /opt/securityhub/config/securityhub.yaml
# 2 = a score below fail_under: an assessment result, not a service failure
SuccessExitStatus=2
# runs start every 4 hours: a stuck run is stopped before the next one is due
TimeoutStartSec=3h
# low priority: the scan uses spare CPU and disk only, SSH and other services stay responsive
Nice=15
CPUWeight=20
IOSchedulingClass=idle
# on a Pi 3 / with other services: cap the CPU (100% = one core) and the memory
# CPUQuota=150%
MemoryHigh=600M
# hardening: read-only system, writable only where the tool writes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/securityhub/reports /opt/securityhub/.cache /var/www/html/securityhub
