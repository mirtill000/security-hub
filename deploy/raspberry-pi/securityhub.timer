# /etc/systemd/system/securityhub.timer - four runs per day, around 06:00, 10:00, 14:00 and 18:00
[Unit]
Description=Security Hub - runs around 06:00, 10:00, 14:00 and 18:00

[Timer]
# start between 5 minutes before and 5 minutes after the hour (spreads the load on DNS and APIs)
OnCalendar=*-*-* 05:55,09:55,13:55,17:55
RandomizedDelaySec=10min
# a run missed while the Pi was off starts at boot
Persistent=true

[Install]
WantedBy=timers.target
